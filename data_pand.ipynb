   "source": [
    "URL = \"https://stephen-king-api.onrender.com/api/books\"\n",
    "res = requests.get(URL)\n",
    "res\n",
    "json_data = res.json()\n",
    "import pandas as pd\n",
    "df = pd.json_normalize(json_data[\"data\"])\n",
    "df = df[[\"id\",\"Year\",\"Title\",\"Publisher\",\"ISBN\"]]\n",
    "df"
   ]
